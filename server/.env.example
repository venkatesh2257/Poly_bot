# --- Dashboard password login (optional; wallet login still works) ---
# When both are set, POST /api/auth/password-login is enabled. No defaults — omit both to disable password auth.
# APP_USER_ID=
# APP_PASSWORD=
# URI line in the wallet EIP-191 message (only included if set). Prefer `SIGN_IN_MESSAGE_URI` (exact dashboard URL),
# or `APP_ORIGIN`. No default — omit both in production and set one explicitly for the deployed UI.
# SIGN_IN_MESSAGE_URI=https://your-dashboard.example.com
# APP_ORIGIN=https://your-dashboard.example.com

# --- Synthesis (synthesis.trade) market data — optional; never routes orders; native CLOB stays execution source of truth ---
# SYNTHESIS_ENABLED=false
# SYNTHESIS_BASE_URL=https://synthesis.trade
# SYNTHESIS_WS_URL=wss://synthesis.trade
# Optional API key if your plan requires it (Bearer on WS connect):
# SYNTHESIS_API_KEY=
# Prefer Synthesis for dashboard orderbook display when healthy (fallback to native if stale):
# SYNTHESIS_DASHBOARD_PREFERRED=true
# Allow strategy evaluation to use Synthesis books only when native CLOB refresh is stale (off by default):
# SYNTHESIS_BOT_FALLBACK_ENABLED=false
# SYNTHESIS_STALE_MS=15000
# Native CLOB book age before considered stale for guardrails (defaults to SYNTHESIS_STALE_MS if unset):
# NATIVE_BOOK_STALE_MS=15000
# Synthesis price / trades stream staleness (orderbook uses SYNTHESIS_STALE_MS):
# SYNTHESIS_PRICE_STALE_MS=15000
# SYNTHESIS_TRADES_STALE_MS=60000
# Native vs Synthesis top-of-book drift (bps on 0–1 price scale):
# SYNTHESIS_DRIFT_WARN_BPS=150
# SYNTHESIS_DRIFT_CRITICAL_BPS=400
# Require both UP/DOWN native books before drift is “complete”:
# SYNTHESIS_DRIFT_REQUIRE_BOTH_SIDES=true
# Throttle [SYNTHESIS][guard] / drift logs:
# SYNTHESIS_DRIFT_LOG_THROTTLE_MS=10000
# Bot strategy fallback only — block Synthesis books when drift exceeds this (separate from display drift warn/critical):
# SYNTHESIS_BOT_FALLBACK_MAX_DRIFT_BPS=300
# When true, do not use Synthesis fallback if drift comparison is incomplete:
# SYNTHESIS_BOT_FALLBACK_REQUIRE_MATCHED_BOOKS=true
# Rolling dashboard history (bounded in-memory; observability only):
# SYNTHESIS_HISTORY_MAX_POINTS=500
# SYNTHESIS_HISTORY_SAMPLE_MS=2000
# SYNTHESIS_HISTORY_MAX_EVENTS=48
# SYNTHESIS_RECONNECT_MIN_MS=1000
# SYNTHESIS_RECONNECT_MAX_MS=60000
# SYNTHESIS_TRADES_LIMIT=200
# SYNTHESIS_CHART_SMOOTH_MS=2000

# --- Mode ---
MODE=LIVE
# For LIVE real-trading tests, set MODE=LIVE, PAPER_TRADING=false, PAPER_ONLY=false, EXECUTE_TRADES=true
# Omitted PAPER_* / EXECUTE_TRADES with MODE=LIVE are auto-filled on boot for real CLOB posts.
# LIVE auto-entries > $1 USDC are allowed unless LIVE_TRADE_ABOVE_1_USD_OK is explicitly false.
# SIMULATION → paper fills (depth simulate or legacy timer); EXECUTE_TRADES only gates real CLOB posts on MODE=LIVE.
# PAPER_TRADING=true (default if unset via index bootstrap)
# EXECUTE_TRADES=false (default if unset)
# PAPER_ONLY=false — when true, no signed order/cancel/market HTTP even on LIVE
#
# Live-run test (headless or after UI “Go LIVE” mirrors this):
# PAPER_TRADING=false
# PAPER_ONLY=false
# EXECUTE_TRADES=true

# --- Polygon RPC ---
# Direct Polygon HTTPS JSON-RPC (Alchemy / Infura — use for local tools or as Worker upstream secret)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-key
# Optional: Cloudflare Worker URL from workers/polygon-rpc-proxy.js (caches eth_chainId at edge)
# POLYGON_RPC_PROXY_URL=https://polygon-rpc-proxy.your-account.workers.dev
# If primary returns 401/403, connectivity ping retries this (default: Ankr public Polygon). Set empty to disable.
# POLYGON_RPC_FALLBACK_URL=https://rpc.ankr.com/polygon
RPC_URL=https://polygon-rpc.com

# --- Signer EOA (L1) — from this private key only; never commit real keys to git ---
EVM_PRIVATE_KEY=<PASTE_TEST_PRIVATE_KEY_HERE>

# --- Polymarket CLOB: trading wallet / funder (proxy Safe) — can differ from signer EOA ---
CLOB_FUNDER_ADDRESS=0x27646946097bcc7b88D275E57eE90ACe769d1c26
# Optional: proxy wallet for Data API /activity connectivity ping only (defaults to CLOB_FUNDER_ADDRESS)
# DATA_API_ACTIVITY_USER=0x27646946097bcc7b88D275E57eE90ACe769d1c26

# Signature type: decimal 0 = EOA, 1 = POLY_PROXY, 2 = GNOSIS_SAFE (proxy wallet). Not hex.
SIGNATURE_TYPE=2
# Legacy alias (optional):
# CLOB_SIGNATURE_TYPE=2

CLOB_HOST=https://clob.polymarket.com
CLOB_CHAIN_ID=137
# Max token_ids per POST /books batch (Polymarket CLOB); default 50
# CLOB_BOOKS_BATCH_CHUNK=50

# --- L2 API credentials (from `node gen-creds.cjs` in this folder) ---
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=
# Alias accepted by server (same value as POLY_PASSPHRASE):
POLY_API_PASSPHRASE=

# --- Dashboard wallet login allowlist (comma-separated). Include EOA signer + funder if both should log in. ---
# Example: ALLOWED_WALLET=0xYourSignerEOA,0xYourFunderSafe
ALLOWED_WALLET=0x27646946097bcc7b88D275E57eE90ACe769d1c26

PORT=4000
# WebSocket shares PORT with the HTTP API (no separate WS_PORT). Override the client with VITE_WS_URL / VITE_WS_PORT only if you run a legacy split-port setup.

START_BALANCE=1000
MIN_TRADE=1
MAX_TRADE=300
# Fixed USDC collateral per bot entry (auto-trades and sizing cap)
ENTRY_USD=1
COOLDOWN_MS=1500
STOP_LOSS=300
MAX_SPREAD=0.15
MIN_LIQUIDITY=80
LIVE_MIN_BEST_BID=0.05
LIVE_MAX_BEST_ASK=0.95

AUTO_DISCOVER_UPDOWN=true
# Multi-asset (recommended): comma-separated; round-robin auto-trades, per-market cooldown.
UPDOWN_ASSETS=BTC,ETH,SOL,XRP
# Legacy single-symbol only (omit UPDOWN_ASSETS if you use this):
# UPDOWN_ASSET=BTC
# If both UPDOWN_ASSETS and UPDOWN_ASSET are omitted, the server defaults to BTC,ETH,SOL,XRP (see `marketDiscovery` / wallet).
MARKET_WARMUP_SEC=90

CLOB_TOKEN_ID=REPLACE_WITH_REAL_MARKET_TOKEN_ID
CLOB_TOKEN_ID_UP=REPLACE_WITH_UP_TOKEN_ID
CLOB_TOKEN_ID_DOWN=REPLACE_WITH_DOWN_TOKEN_ID

AUTO_START_BOT=false

# Entry direction (dashboard can override until reset):
#   momentum — tick/window momentum + books
#   anchor — Anchor Strategy (see ANCHOR_* below; requires ANCHOR_STRATEGY_ENABLED=true for live eval)
#   market_making — Polymarket crypto ~5m YES-token quoting (SIM logs; MM_LIVE_ENABLED for future CLOB maker wiring)
#   fair_value_arb — PM5m digital vs YES asks (FVA_* + FVA_PM5M_*; oracle spot + price-to-beat)
#   selective_momentum — PM5m sparse momentum (SM_* + SM_PM5M_*; expiry + executable ask gates)
# ENTRY_STRATEGY=momentum

# --- Market making — Polymarket crypto ~5m YES tokens (default off; live maker not implemented) ---
# MM_ENABLED=false
# MM_LIVE_ENABLED=false
# MM_PM5M_MIN_OUTCOME_SPREAD=0.02
# MM_PM5M_MIN_LIQUIDITY_PER_OUTCOME=80
# MM_PM5M_MAX_INVENTORY_SKEW_USD=500
# MM_PM5M_MAX_NOTIONAL_PER_WINDOW_USD=250
# MM_PM5M_STOP_QUOTE_SEC_BEFORE_EXPIRY=45
# MM_PM5M_MIN_SEC_AFTER_WINDOW_OPEN=0
# MM_PM5M_MAX_PER_OUTCOME_NOTIONAL_USD=0
# MM_REPRICE_MIN_MS=2000
# Legacy aliases still read: MM_SPREAD_FLOOR, MM_MIN_LIQUIDITY_PER_SIDE, MM_MAX_INVENTORY_IMBALANCE, MM_MAX_NOTIONAL_USD_PER_WINDOW, MM_STOP_QUOTE_SEC_LEFT
# MM_SIM_INVENTORY_TICK_USD=0.01

# --- Fair value arb — PM5m (default off) ---
# FVA_ENABLED=false
# FVA_MIN_EDGE=0.02
# FVA_FEE_BUFFER=0.01
# FVA_SLIPPAGE_BUFFER=0.005
# FVA_VOL_ANNUAL=0.85
# FVA_PM5M_MIN_SEC_TO_EXPIRY=30
# FVA_PM5M_MAX_SEC_REMAINING_FOR_ENTRY=0
# Legacy: FVA_MIN_SEC_LEFT

# --- Selective momentum — PM5m (default off) ---
# SM_ENABLED=false
# SM_MIN_IMPULSE=0.015
# SM_PERSISTENCE_TICKS=3
# SM_PM5M_MAX_OUTCOME_SPREAD=0.12
# SM_REQUIRE_BOOK_CONFIRM=true
# TTE band (seconds **remaining** until Gamma expiry): min = block if too close to end; max = block if too early (too much time left)
# SM_PM5M_MIN_SEC_REMAINING=45
# SM_PM5M_MAX_SEC_REMAINING=240
# Legacy aliases still read: SM_PM5M_MIN_SEC_TO_EXPIRY, SM_PM5M_MAX_SEC_TO_EXPIRY, SM_MIN_SEC_LEFT, SM_MAX_SEC_LEFT
# SM_PM5M_MAX_YES_ASK=0.72
# Legacy: SM_MAX_SPREAD, SM_MIN_SEC_LEFT, SM_MAX_SEC_LEFT, SM_MAX_ENTRY_ASK

# Paper/SIM: optional early exit when book mid ≥ entryVWAP × (1 + this). Env names unchanged for compatibility.
# WHALE_PAPER_TP_RELATIVE=0.45
# WHALE_PAPER_TP_POLL_MS=2000

# Paper oracle-binary (SIM + PAPER_BINARY_SETTLE=true): min time after entry fill before oracle settle; skip entries near window end; aggressive paper BUY cross.
# PAPER_ORACLE_MIN_HOLD_MS=300000
# Min ms left in Gamma window before allowing entry (ORACLE_TOO_CLOSE). Global default if unset: 20000 (see engine.ts).
# MIN_MS_TO_WINDOW_END=20000
# Legacy alias (still honored if MIN_MS_TO_WINDOW_END unset):
# PAPER_ENTRY_MIN_MS_TO_WINDOW_END=60000
# BTC 5m up/down only (~300s window): min ms remaining before window end for paper ORACLE_TOO_CLOSE. If unset, default 500 (not global 20s).
# MIN_MS_TO_WINDOW_END_BTC=500
# Optional: if >0, also block within this many ms after window end (default 0 = do not block after end).
# BTC_5M_POST_WINDOW_END_BUFFER_MS=0
# Log rollup: cumulative [BTC_5M_ENTRY_BUCKETS] by seconds-to-window-end (0–5s … >20s) every N completed BTC 5m AUTO trades.
# BTC_5M_ENTRY_BUCKET_ROLLUP_EVERY=10
# Orphan BTC 5m analytics contexts (no settlement) are removed after this TTL; health/cleanup runs on the runtime health log cadence.
# BTC_5M_ENTRY_CONTEXT_TTL_MS=900000
# PAPER_ENTRY_ASK_CROSS_BUFFER=0.002
# Paper fill economics (SIM): PAPER_FEE_BPS overrides PAPER_TAKER_FEE_RATE when set (incl. 0). PAPER_SLIPPAGE_BPS widens BUY limit vs mid. PAPER_MARK_TO_BID=false uses mid for open mark.
# PAPER_FEE_BPS=0
# PAPER_SLIPPAGE_BPS=10
# PAPER_MARK_TO_BID=true
# PAPER_BINARY_SETTLE — default true: window-end paper settle uses $1/$0 payout vs price-to-beat (+ fees). Set false to simulate a bid-side market sell instead.
# Optional LIVE BUY: limit price ≥ best ask + buffer (unset = off).
# LIVE_ENTRY_ASK_CROSS_BUFFER=

# Auto-trade (non–Lag Snipe; uses slow tick unless ANCHOR_FAST_LANE): soft/hard Chainlink staleness, strike-based trend + flip gate, late-window skip, LIVE $1 cap.
# ORACLE_SOURCE=chainlink
# ORACLE_SOFT_STALE_MS=15000
# ORACLE_HARD_STALE_MS=45000
# ORACLE_TREND_BPS=4
# ORACLE_FLIP_DEADBAND_BPS=3
# ORACLE_FLIP_BLOCK_COUNT=1
# ORACLE_OPPOSITE_TICKS_BLOCK=2
# ORACLE_MISMATCH_EARLY_WINDOW_MS=60000
# ORACLE_MISMATCH_STRONG_BPS=8
# Min |deltaBps| from window open (strike) for BTC/ETH/SOL/XRP entries; trend must be UP or DOWN.
# MIN_WINDOW_DELTA_BPS=4
# LATE_ENTRY_MIN_MS_TO_WINDOW_END=120000
# LIVE_TRADE_ABOVE_1_USD_OK=false
# Legacy buffer trend (health / other paths only; auto gate uses strike-based trend):
# ORACLE_TREND_MIN_SAMPLES=2
# ORACLE_TREND_MAX_SAMPLE_AGE_MS=20000

# Momentum (only when ENTRY_STRATEGY=momentum): ticks = sum of per-tick BTC moves; weighted = newest ticks count more; from_open = BTC vs start of current 5m window (good for UP/DOWN windows).
# MOMENTUM_MODE=ticks
# MOMENTUM_PREDICT_LOOKBACK=10
# MOMENTUM_SCORE_LOOKBACK=8
# MOMENTUM_VOLATILITY_LOOKBACK=12
# MOMENTUM_TICK_SCALE=0.2
# MOMENTUM_FROM_OPEN_USD_PER_CONF=25
# MOMENTUM_MAX_CONF_BOOST=4

# Optional signal filter: requires chosen-side mid ≥ HIGH_CONF_MID_THRESHOLD OR (confidence×mid) ≥ same.
# SIGNAL_MODE=highConf
# HIGH_CONF_MID_THRESHOLD=0.92

# After a LIVE entry BUY fills, post a FAK market SELL to flatten the outcome token (dashboard stays PENDING if this fails).
LIVE_CLOSE_ENTRY_ON_FILL=true

# Optional GTC hedge on opposite token (disabled automatically when LIVE_CLOSE_ENTRY_ON_FILL=true).
# GTC_EXIT_ENABLED=true

# --- BONE entry filters (optional AND gates: every enabled filter must pass on each entry; SIM + LIVE). Logs: grep BONE_BLOCK
# 1) High-configuration scalping — tight conf + mid / conf×mid + side depth vs pair
# 2) 50/50 equilibrium — both UP/DOWN mids near 0.5
# 3) Longshot — cheap-side (default) or favorite mode
# 4) Latency / move proxy — BTC move from 5m window open (bps), shared across assets
# Uncomment to enable (all four together is very strict; tune or enable selectively):
# BONE_HIGH_CONF=true
# BONE_HIGH_CONF_MIN_PCT=96
# BONE_HIGH_CONF_MIN_CM=0.60
# BONE_HIGH_CONF_WHALE_FRAC=0.60
# BONE_EQ=true
# BONE_EQ_BAND=0.08
# BONE_LONGSHOT=true
# BONE_LONGSHOT_MODE=cheap
# BONE_LONGSHOT_MAX_MID=0.42
# BONE_LONGSHOT_MIN_MID=0.58
# BONE_LATENCY=true
# BONE_LATENCY_MIN_MOVE_BPS=5
# (Uses each active market’s symbol: spot move vs window open from Coinbase/Binance, not BTC-only.)
# Optional extra mid gate (separate from BONE_HIGH_CONF): SIGNAL_MODE=highConf
# HIGH_CONF_MID_THRESHOLD=0.92

# --- Anchor Strategy (bid-depth + Chainlink momentum) ---
#
# Anchor LIVE $1 test
# MODE=LIVE
# ENTRY_STRATEGY=anchor
# ANCHOR_STRATEGY_ENABLED=true
# ANCHOR_ALLOW_FALLBACK=false
# ANCHOR_TRADE_SIZE=1.00
# ANCHOR_FAST_LANE=false
# ANCHOR_DEBUG_LOGS=true
#
# Primary: ENTRY_STRATEGY=anchor (or dashboard strategy anchor). Also enable:
# ANCHOR_STRATEGY_ENABLED=true
# Live CLOB (server dashboard): executor gate + dry-run off
# ANCHOR_LIVE_EXECUTOR_AVAILABLE=true
# DRY_RUN=false
# Optional: run Anchor after other strategies skip (default false)
# ANCHOR_ALLOW_FALLBACK=false
# Optional: faster auto-trade cadence when Anchor is primary (uses OLA_AUTO_MS interval; default false)
# ANCHOR_FAST_LANE=false
# ANCHOR_STABILITY_TICKS=3
# ANCHOR_IMBALANCE_THRESHOLD=0.70
# ANCHOR_IMBALANCE_DOWN_WEAK=0.30
# ANCHOR_CHAINLINK_MOM_THRESHOLD=0.0003
# ANCHOR_MOM_REVERSE_THRESHOLD=-0.0005
# ANCHOR_PRICE_MIN=0.40
# ANCHOR_PRICE_MAX=0.65
# ANCHOR_TRADE_SIZE=1.00
# ANCHOR_EXIT_BUFFER_SECONDS=30
# ANCHOR_MAX_YES_MID=0.70
# ANCHOR_MIN_SECONDS_TO_EXPIRY=60
# Max age (ms) of Chainlink/oracle tick + buffer sample for momentum (stale guard)
# ANCHOR_MAX_ORACLE_AGE_MS=15000
# Number of oracle prices in buffer required for momentum (default 4 → vs 3 steps back)
# ANCHOR_MOMENTUM_LOOKBACK_PRICES=4
# Verbose ANCHOR_SIGNAL JSON logs every evaluation tick (noisy)
# ANCHOR_DEBUG_LOGS=false
