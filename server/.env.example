# --- Dashboard (local only; not Polymarket.com email) ---
APP_USER_ID=admin
APP_PASSWORD=admin123

# --- Mode ---
MODE=LIVE

# --- Polygon RPC ---
# Direct Polygon HTTPS JSON-RPC (Alchemy / Infura — use for local tools or as Worker upstream secret)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-key
# Optional: Cloudflare Worker URL from workers/polygon-rpc-proxy.js (caches eth_chainId at edge)
# POLYGON_RPC_PROXY_URL=https://polygon-rpc-proxy.your-account.workers.dev
# If primary returns 401/403, connectivity ping retries this (default: Ankr public Polygon). Set empty to disable.
# POLYGON_RPC_FALLBACK_URL=https://rpc.ankr.com/polygon
RPC_URL=https://polygon-rpc.com

# --- Signer EOA (L1) — from this private key only; never commit real keys to git ---
EVM_PRIVATE_KEY=<PASTE_TEST_PRIVATE_KEY_HERE>

# --- Polymarket CLOB: trading wallet / funder (proxy Safe) — can differ from signer EOA ---
CLOB_FUNDER_ADDRESS=0x27646946097bcc7b88D275E57eE90ACe769d1c26
# Optional: proxy wallet for Data API /activity connectivity ping only (defaults to CLOB_FUNDER_ADDRESS)
# DATA_API_ACTIVITY_USER=0x27646946097bcc7b88D275E57eE90ACe769d1c26

# Signature type: decimal 0 = EOA, 1 = POLY_PROXY, 2 = GNOSIS_SAFE (proxy wallet). Not hex.
SIGNATURE_TYPE=2
# Legacy alias (optional):
# CLOB_SIGNATURE_TYPE=2

CLOB_HOST=https://clob.polymarket.com
CLOB_CHAIN_ID=137
# Max token_ids per POST /books batch (Polymarket CLOB); default 50
# CLOB_BOOKS_BATCH_CHUNK=50

# --- L2 API credentials (from `node gen-creds.cjs` in this folder) ---
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=
# Alias accepted by server (same value as POLY_PASSPHRASE):
POLY_API_PASSPHRASE=

# --- Dashboard wallet login allowlist (comma-separated). Include EOA signer + funder if both should log in. ---
# Example: ALLOWED_WALLET=0xYourSignerEOA,0xYourFunderSafe
ALLOWED_WALLET=0x27646946097bcc7b88D275E57eE90ACe769d1c26

PORT=4000
WS_PORT=4011

START_BALANCE=1000
MIN_TRADE=1
MAX_TRADE=300
# Fixed USDC collateral per bot entry (auto-trades and sizing cap)
ENTRY_USD=1
COOLDOWN_MS=1500
STOP_LOSS=300
MAX_SPREAD=0.15
MIN_LIQUIDITY=80
LIVE_MIN_BEST_BID=0.05
LIVE_MAX_BEST_ASK=0.95

AUTO_DISCOVER_UPDOWN=true
# Multi-asset (recommended): comma-separated; round-robin auto-trades, per-market cooldown.
UPDOWN_ASSETS=BTC,ETH,SOL,XRP,DOGE
# Legacy single-symbol only (omit UPDOWN_ASSETS if you use this):
# UPDOWN_ASSET=BTC
# If both UPDOWN_ASSETS and UPDOWN_ASSET are omitted, the server defaults to BTC,ETH,SOL,XRP,DOGE.
MARKET_WARMUP_SEC=90

CLOB_TOKEN_ID=REPLACE_WITH_REAL_MARKET_TOKEN_ID
CLOB_TOKEN_ID_UP=REPLACE_WITH_UP_TOKEN_ID
CLOB_TOKEN_ID_DOWN=REPLACE_WITH_DOWN_TOKEN_ID

AUTO_START_BOT=false

# Entry direction (empty = ensemble — all legs combined):
#   ensemble — weighted sum: momentum + orderbook + mean_revert + chart + MID_FLIP + LAST_SECOND_COLLAPSE + REVERSAL_SNIPE (aliases: all, combined)
#   momentum — tick/window momentum + orderbook mix
#   contrarian — fade tick/window momentum (.env-only; not on dashboard)
#   orderbook — live: higher mid when both sides tradable
#   mean_revert — fade average synthetic chart UP% vs 50 (aliases: revert, fade_odds)
#   chart — follow latest bar synthetic UP vs 50 (aliases: pseudo, synthetic)
#   whale_edge — tilt + WHALE_* gates only (no ensemble mix)
# ENTRY_STRATEGY=

# --- Ensemble weights & tactics (ENTRY_STRATEGY=ensemble or unset) ---
# ENSEMBLE_W_MOMENTUM=1
# ENSEMBLE_W_ORDERBOOK=1
# ENSEMBLE_W_MEAN_REVERT=0.65
# ENSEMBLE_W_CHART=0.7
# ENSEMBLE_W_MID_FLIP=1.15
# ENSEMBLE_W_LAST_SECOND_COLLAPSE=1.45
# ENSEMBLE_W_REVERSAL_SNIPE=1.2
# ENSEMBLE_MID_RING_MAX=40
# ENSEMBLE_LSC_MAX_SEC_LEFT=38
# ENSEMBLE_LSC_MIN_SEC_LEFT=4
# ENSEMBLE_LSC_DROP=0.11
# ENSEMBLE_LSC_FAV_MIN=0.52
# ENSEMBLE_REV_EXTREME=0.72
# ENSEMBLE_REV_DROP=0.065
# Apply whale_edge time/spread/mid-band gates to the final ensemble vote (recommended):
# ENSEMBLE_APPLY_WHALE_FILTER=true
# ENSEMBLE_USE_CONTRARIAN_MOMENTUM=false

# --- Whale edge (ENTRY_STRATEGY=whale_edge or dashboard "Whale edge") ---
# Skip first N seconds of each 5m window (reduces CSV-style warmup noise).
# WHALE_MIN_SEC_IN_WINDOW=120
# Skip when fewer than N seconds remain (avoid resolution lottery).
# WHALE_MIN_SEC_TO_EXPIRY=55
# Max spread on the side you buy (decimal 0–1).
# WHALE_MAX_SPREAD=0.055
# Do not buy if implied prob is too extreme (lottery / no upside).
# WHALE_ENTRY_MID_MIN=0.1
# WHALE_ENTRY_MID_MAX=0.78
# Require |UP_mid − DOWN_mid| ≥ this (skip 50/50 coin flips).
# WHALE_MIN_BOOK_EDGE=0.03
# WHALE_SKIP_WARMUP=true
# Optional: require spot vs price-to-beat to agree with direction (needs RTDS + Gamma PTB).
# WHALE_REQUIRE_ORACLE_ALIGN=false
# WHALE_ORACLE_EPS_USD=0
# Paper/SIM: exit early when book mid ≥ entryVWAP × (1 + this). 0.5 ≈ +50% relative move in price space.
# WHALE_PAPER_TP_RELATIVE=0.45
# WHALE_PAPER_TP_POLL_MS=2000

# Paper oracle-binary (SIM + PAPER_BINARY_SETTLE=true): min time after entry fill before oracle settle; skip entries near window end; aggressive paper BUY cross.
# PAPER_ORACLE_MIN_HOLD_MS=300000
# PAPER_ENTRY_MIN_MS_TO_WINDOW_END=60000
# PAPER_ENTRY_ASK_CROSS_BUFFER=0.002
# Optional LIVE BUY: limit price ≥ best ask + buffer (unset = off).
# LIVE_ENTRY_ASK_CROSS_BUFFER=

# Auto-trade (non–Lag Snipe, non-OLA): oracle freshness vs min(Chainlink on-chain age, RTDS age), late-window skip, LIVE $1 cap.
# ORACLE_MAX_AGE_MS_ENTRY=15000
# LATE_ENTRY_MIN_MS_TO_WINDOW_END=120000
# LIVE_TRADE_ABOVE_1_USD_OK=false
# Per-asset Chainlink buffer: min samples + max age of newest sample before oracle trend is valid.
# ORACLE_TREND_MIN_SAMPLES=2
# ORACLE_TREND_MAX_SAMPLE_AGE_MS=20000

# Mean-revert strategy only:
# MEAN_REVERT_LOOKBACK=8
# MEAN_REVERT_THRESHOLD=2

# Momentum (only when ENTRY_STRATEGY=momentum): ticks = sum of per-tick BTC moves; weighted = newest ticks count more; from_open = BTC vs start of current 5m window (good for UP/DOWN windows).
# MOMENTUM_MODE=ticks
# MOMENTUM_PREDICT_LOOKBACK=10
# MOMENTUM_SCORE_LOOKBACK=8
# MOMENTUM_VOLATILITY_LOOKBACK=12
# MOMENTUM_TICK_SCALE=0.2
# MOMENTUM_FROM_OPEN_USD_PER_CONF=25
# MOMENTUM_MAX_CONF_BOOST=4

# Optional signal filter: requires chosen-side mid ≥ HIGH_CONF_MID_THRESHOLD OR (confidence×mid) ≥ same.
# SIGNAL_MODE=highConf
# HIGH_CONF_MID_THRESHOLD=0.92

# After a LIVE entry BUY fills, post a FAK market SELL to flatten the outcome token (dashboard stays PENDING if this fails).
LIVE_CLOSE_ENTRY_ON_FILL=true

# Optional GTC hedge on opposite token (disabled automatically when LIVE_CLOSE_ENTRY_ON_FILL=true).
# GTC_EXIT_ENABLED=true

# --- BONE entry filters (optional AND gates: every enabled filter must pass on each entry; SIM + LIVE). Logs: grep BONE_BLOCK
# 1) High-configuration scalping — tight conf + mid / conf×mid + side depth vs pair
# 2) 50/50 equilibrium — both UP/DOWN mids near 0.5
# 3) Longshot — cheap-side (default) or favorite mode
# 4) Latency / move proxy — BTC move from 5m window open (bps), shared across assets
# Uncomment to enable (all four together is very strict; tune or enable selectively):
# BONE_HIGH_CONF=true
# BONE_HIGH_CONF_MIN_PCT=96
# BONE_HIGH_CONF_MIN_CM=0.60
# BONE_HIGH_CONF_WHALE_FRAC=0.60
# BONE_EQ=true
# BONE_EQ_BAND=0.08
# BONE_LONGSHOT=true
# BONE_LONGSHOT_MODE=cheap
# BONE_LONGSHOT_MAX_MID=0.42
# BONE_LONGSHOT_MIN_MID=0.58
# BONE_LATENCY=true
# BONE_LATENCY_MIN_MOVE_BPS=5
# (Uses each active market’s symbol: spot move vs window open from Coinbase/Binance, not BTC-only.)
# Optional extra mid gate (separate from BONE_HIGH_CONF): SIGNAL_MODE=highConf
# HIGH_CONF_MID_THRESHOLD=0.92

# --- Anchor Strategy (bid-depth + Chainlink momentum) ---
# Primary: ENTRY_STRATEGY=anchor (or dashboard strategy anchor). Also enable:
# ANCHOR_STRATEGY_ENABLED=true
# Optional: run Anchor after other strategies skip (default false)
# ANCHOR_ALLOW_FALLBACK=false
# Optional: use OLA fast-lane cadence when Anchor is primary (default false)
# ANCHOR_FAST_LANE=false
# ANCHOR_STABILITY_TICKS=3
# ANCHOR_IMBALANCE_THRESHOLD=0.70
# ANCHOR_IMBALANCE_DOWN_WEAK=0.30
# ANCHOR_CHAINLINK_MOM_THRESHOLD=0.0003
# ANCHOR_MOM_REVERSE_THRESHOLD=-0.0005
# ANCHOR_PRICE_MIN=0.40
# ANCHOR_PRICE_MAX=0.65
# ANCHOR_TRADE_SIZE=1.00
# ANCHOR_EXIT_BUFFER_SECONDS=30
# ANCHOR_MAX_YES_MID=0.70
# ANCHOR_MIN_SECONDS_TO_EXPIRY=60
# Max age (ms) of Chainlink/oracle tick + buffer sample for momentum (stale guard)
# ANCHOR_MAX_ORACLE_AGE_MS=15000
# Number of oracle prices in buffer required for momentum (default 4 → vs 3 steps back)
# ANCHOR_MOMENTUM_LOOKBACK_PRICES=4
# Verbose ANCHOR_SIGNAL JSON logs every evaluation tick (noisy)
# ANCHOR_DEBUG_LOGS=false
